# Reference only, not loaded by Next.js. Configure these in Vercel's Production scope.
# Leave both launch gates OFF until hosted schema/data, account and access checks pass.
MEMBER_HUB_ENABLED=false
MEMBER_HUB_ENVIRONMENT=production
MEMBER_HUB_PRODUCTION_READY=false
MEMBER_HUB_SITE_URL=https://cypressdalehoa.com

# Reuse the current project's URL and service key. Do not create another project.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Existing project's anon/public key, NOT its service or secret key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Reuse the current provider key; verify the sender domain before enabling delivery.
RESEND_API_KEY=
NEWSLETTER_FROM=Cypressdale HOA <no-reply@cypressdalehoa.com>
NEWSLETTER_DELIVERY_ENABLED=false
NEWSLETTER_DELIVERY_MODE=test
NEWSLETTER_TEST_RECIPIENTS=
NEWSLETTER_PRODUCTION_DELIVERY_READY=false

# Vercel automatically sends this as Authorization: Bearer <secret> for cron jobs.
# Use a strong random secret. Do not reuse the former query-string webhook password.
CRON_SECRET=
