# Local/staging example. Production uses .env.member-hub.production.example.
MEMBER_HUB_ENABLED=false
MEMBER_HUB_ENVIRONMENT=local
MEMBER_HUB_SUPABASE_URL=http://127.0.0.1:55421
MEMBER_HUB_SITE_URL=http://localhost:3001
MEMBER_HUB_SUPABASE_PUBLISHABLE_KEY=
MEMBER_HUB_SUPABASE_SERVICE_ROLE_KEY=

# Staging requires the live project's URL as an exclusion, never its credentials.
MEMBER_HUB_PRODUCTION_SUPABASE_URL=

# Local newsletters always go to Mailpit, never to Resend.
# Hosted staging delivery is opt-in and restricted to these comma-separated addresses.
NEWSLETTER_DELIVERY_ENABLED=false
NEWSLETTER_STAGING_RECIPIENTS=
NEWSLETTER_DELIVERY_MODE=test
NEWSLETTER_TEST_RECIPIENTS=
NEWSLETTER_FROM=Cypressdale HOA <no-reply@cypressdalehoa.com>
RESEND_API_KEY=
# Scheduling uses Authorization: Bearer <secret>, not a query-string passphrase.
NEWSLETTER_CRON_SECRET=
